# Copy this file to settings.env (same folder) and fill it in.
# settings.env is gitignored.
#
# Nothing secret goes in here. Database passwords, the new project's secret
# key and your Supabase access tokens are asked for when a script runs, and
# are never written to disk.

# ── OLD project (the one shutting down) ────────────────────────────────────
OLD_PROJECT_REF=krooorixhjwygcsdoomg

# Dashboard of the OLD project → Connect (top bar) → "Session pooler".
# Paste the URI exactly as shown, [YOUR-PASSWORD] and all. Use the Session
# pooler (port 5432), not "Direct connection" (IPv6-only, usually fails on
# home internet) and not "Transaction pooler" (port 6543, breaks pg_dump).
OLD_DB_URL=postgresql://postgres.krooorixhjwygcsdoomg:[YOUR-PASSWORD]@aws-0-REPLACE-REGION.pooler.supabase.com:5432/postgres

# ── NEW project ────────────────────────────────────────────────────────────
# The ref is the random part of the project URL: https://<ref>.supabase.co
NEW_PROJECT_REF=REPLACE-ME

# Dashboard of the NEW project → Connect → "Session pooler", same as above.
NEW_DB_URL=postgresql://postgres.REPLACE-ME:[YOUR-PASSWORD]@aws-0-REPLACE-REGION.pooler.supabase.com:5432/postgres

# Dashboard of the NEW project → Project Settings → Data API → Project URL.
NEW_SUPABASE_URL=https://REPLACE-ME.supabase.co

# Dashboard of the NEW project → Project Settings → API Keys →
# "Publishable key" (starts with sb_publishable_). This replaces the old anon
# key everywhere. It is public by design: it ships inside the app and the
# portal, exactly as the anon key did.
NEW_PUBLISHABLE_KEY=sb_publishable_REPLACE-ME
