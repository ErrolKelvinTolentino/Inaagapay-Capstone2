# Secrets for the Edge Functions on the NEW project.
#
# 3-edge-functions.ps1 creates functions.secrets.env from this file the first
# time it runs, pre-filling what it can from inaagapay_flutter_v2/.env, and
# then stops so you can check it. functions.secrets.env is gitignored.
#
# Supabase never shows a secret's value again after it is set, so nothing can
# be copied from the old project: the values come from the providers
# themselves (Semaphore, Brevo, Firebase). Lines left empty are skipped.
#
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SECRET_KEYS are provided
# by Supabase automatically; do not add them here.

# Semaphore (SMS) - send-sms, send-reminders, send-push
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=AGAPAY
SEMAPHORE_BASE_URL=https://api.semaphore.co/api/v4

# Brevo (email) - send-email
BREVO_API_KEY=

# Firebase Cloud Messaging service account private key - send-push
# One line, newlines written as \n, inside double quotes:
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FCM_PRIVATE_KEY=

# The admin portal's address, for CORS on send-sms and send-reminders,
# e.g. https://inaagapay.vercel.app  (leave empty to allow any origin, as now)
ALLOWED_ORIGIN=
