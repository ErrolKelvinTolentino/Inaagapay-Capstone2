        <mxCell id="r19-id" value="AW-TC-019" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2332" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r19-feature" value="Responsive &amp; Failure States" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="2332" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r19-scenario" value="&lt;b&gt;Responsive navigation, empty data, and request failure&lt;/b&gt;&lt;br&gt;1. Test key pages at desktop, tablet, and phone widths. 2. Toggle/close the sidebar. 3. Use an empty dataset. 4. Simulate a failed data request." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="2332" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r19-expected" value="Content remains readable without horizontal overlap; sidebar opens/closes and keyboard focus is visible; empty states explain that no records exist; failures show a recoverable error/retry path without stale or fabricated totals." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="2332" width="750" height="104" as="geometry" /></mxCell>
