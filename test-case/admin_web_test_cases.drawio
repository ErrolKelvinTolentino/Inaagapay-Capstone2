        <mxCell id="r17-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="2124" width="160" height="104" as="geometry" /></mxCell>
