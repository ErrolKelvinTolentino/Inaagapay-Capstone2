  <diagram id="admin-web-test-cases" name="Admin Web Test Cases">
    <mxGraphModel dx="2400" dy="2680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="INAAGAPAY ADMIN WEB — MANUAL TEST CASES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6398D;gradientColor=#FF7EB3;strokeColor=#C73578;fontColor=#FFFFFF;fontSize=30;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=28;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="2300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Scope: admin-web only  •  Test type: manual functional, security, validation, and regression  •  Baseline: Chrome or Edge with test Supabase data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#5F4552;fontSize=16;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="112" width="2300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="metadata" value="&lt;b&gt;Iteration:&lt;/b&gt; __________    &lt;b&gt;Tester:&lt;/b&gt; ____________________    &lt;b&gt;Execution date:&lt;/b&gt; __________    &lt;b&gt;Browser / build:&lt;/b&gt; ______________________________" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F2F5;strokeColor=#DCC9D3;fontColor=#49343F;fontSize=15;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="2300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="preconditions" value="&lt;b&gt;COMMON PRECONDITIONS&lt;/b&gt;&lt;br&gt;1. Use dedicated test accounts for an active/verified MHO, RHU admin, midwife, mother, temporary-password user, unverified user, and suspended user.&lt;br&gt;2. Seed representative facilities, accounts, patients, inventory batches, stock requests, reports, and audit entries. Use non-production data only.&lt;br&gt;3. Begin each authentication/security case with a clean browser session unless the steps say otherwise. Do not perform backup/restore tests against production." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F8;strokeColor=#FF68A5;strokeWidth=2;fontColor=#49343F;fontSize=14;align=left;verticalAlign=middle;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="228" width="2300" height="142" as="geometry" />
        </mxCell>

        <mxCell id="h-id" value="TEST ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="400" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="h-feature" value="FEATURE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="180" y="400" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="h-scenario" value="SCENARIO &amp; STEPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="410" y="400" width="790" height="60" as="geometry" /></mxCell>
        <mxCell id="h-expected" value="EXPECTED RESULT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="750" height="60" as="geometry" /></mxCell>
        <mxCell id="h-priority" value="PRIORITY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="400" width="120" height="60" as="geometry" /></mxCell>
        <mxCell id="h-status" value="STATUS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="400" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="h-actual" value="ACTUAL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7D214E;strokeColor=#64183E;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="400" width="120" height="60" as="geometry" /></mxCell>

        <mxCell id="r1-id" value="AW-TC-001" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="460" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-feature" value="Authentication" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="460" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-scenario" value="&lt;b&gt;Valid RHU administrator login&lt;/b&gt;&lt;br&gt;1. Open admin-web/index.html. 2. Enter an active, verified RHU admin email and password. 3. Select Sign In." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="460" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-expected" value="Authentication succeeds; an admin session and RHU portal scope are stored; the user lands on Dashboard and sees only the assigned RHU and its child facilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="460" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="460" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="460" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r1-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="460" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r2-id" value="AW-TC-002" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="564" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-feature" value="Authentication" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="564" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-scenario" value="&lt;b&gt;Valid MHO login and municipal scope&lt;/b&gt;&lt;br&gt;1. Clear the prior session. 2. Sign in with an active, verified MHO account. 3. Open Dashboard and Facilities." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="564" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-expected" value="MHO session and municipal scope are stored; municipal labels and MHO-only facility navigation appear; data covers the authorized RHUs and subordinate facilities only." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="564" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="564" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="564" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r2-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="564" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r3-id" value="AW-TC-003" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="668" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-feature" value="Login Validation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="668" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-scenario" value="&lt;b&gt;Blank or invalid credentials&lt;/b&gt;&lt;br&gt;1. Submit with either field blank. 2. Retry with an unknown email. 3. Retry with a valid email and wrong password." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="668" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-expected" value="Blank input shows the required-credentials message. Unknown email and wrong password show the same generic invalid-credentials message. No portal session is created and no protected page opens." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="668" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="668" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="668" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r3-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="668" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r4-id" value="AW-TC-004" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="772" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-feature" value="Role &amp; Account State" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="772" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-scenario" value="&lt;b&gt;Reject unauthorized or unusable accounts&lt;/b&gt;&lt;br&gt;Attempt login using: (a) midwife, (b) mother, (c) unverified admin, (d) inactive admin, and (e) suspended admin." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="772" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-expected" value="Mobile-only roles receive the access-denied message. Unverified and inactive/suspended accounts receive their applicable status message. Access is blocked and local session/scope data remain absent." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="772" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="772" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="772" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r4-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="772" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r5-id" value="AW-TC-005" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="876" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-feature" value="First Login" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="876" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-scenario" value="&lt;b&gt;Forced temporary-password change&lt;/b&gt;&lt;br&gt;1. Sign in with a temporary password. 2. Try incomplete, weak, mismatched, same-as-current, and wrong-current values. 3. Submit a valid replacement." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="876" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-expected" value="User is routed to Change Password. Invalid combinations are blocked with clear messages. A valid 8+ character password containing upper/lowercase and a number is saved, the temporary flag clears, audit is recorded, and Dashboard opens." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="876" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="876" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="876" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r5-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="876" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r6-id" value="AW-TC-006" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="980" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-feature" value="Session Security" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="980" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-scenario" value="&lt;b&gt;Protected route, stale session, and inactivity&lt;/b&gt;&lt;br&gt;1. Open a protected page with no session. 2. Repeat with a session older than 12 hours. 3. Stay inactive for 15 minutes on an authenticated page." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="980" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-expected" value="Unauthorized and stale sessions are cleared and redirected to Login. An inactive session times out, informs the user, clears stored authentication data, and blocks browser-back access to protected content." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="980" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-priority" value="P0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#C62828;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="980" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="980" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r6-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="980" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r7-id" value="AW-TC-007" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1084" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-feature" value="Dashboard" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="1084" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-scenario" value="&lt;b&gt;Scoped operational overview and export&lt;/b&gt;&lt;br&gt;1. Open Dashboard with seeded data. 2. Compare KPI cards, charts, recent activity, and quick links to source records. 3. Export the PDF summary." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="1084" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-expected" value="Metrics and charts match records inside the signed-in office scope; navigation opens the correct modules; loading/empty states remain usable; the PDF downloads with current, readable scoped totals." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="1084" width="750" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-priority" value="P1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#D97706;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1950" y="1084" width="120" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-status" value="Not Started" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#8A5D00;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2070" y="1084" width="160" height="104" as="geometry" /></mxCell>
        <mxCell id="r7-actual" value="—" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#6E5A64;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2230" y="1084" width="120" height="104" as="geometry" /></mxCell>

        <mxCell id="r8-id" value="AW-TC-008" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="1188" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r8-feature" value="Account Creation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="1188" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r8-scenario" value="&lt;b&gt;Create a valid in-scope account&lt;/b&gt;&lt;br&gt;1. Open Account Management and Add Account. 2. Complete required identity, role, contact, and facility fields. 3. Save once." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="1188" width="790" height="104" as="geometry" /></mxCell>
