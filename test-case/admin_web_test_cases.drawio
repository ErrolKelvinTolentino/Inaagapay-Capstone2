        <mxCell id="r18-id" value="AW-TC-018" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2228" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r18-feature" value="Backup &amp; Restore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="2228" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r18-scenario" value="&lt;b&gt;Export and safely validate a selective restore&lt;/b&gt;&lt;br&gt;1. Download a JSON backup from test data. 2. Inspect metadata/counts. 3. Upload a valid backup and review the preview. 4. Cancel, then test malformed/wrong-schema input." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="2228" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r18-expected" value="Backup downloads with expected scoped datasets and metadata. Restore provides a clear preview and explicit confirmation. Cancel/malformed input changes nothing; errors are actionable; authorized test restore is audited and preserves referential integrity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="2228" width="750" height="104" as="geometry" /></mxCell>
