        <mxCell id="r20-id" value="AW-TC-020" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#7D214E;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="2436" width="130" height="104" as="geometry" /></mxCell>
        <mxCell id="r20-feature" value="Logout" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#49343F;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="180" y="2436" width="230" height="104" as="geometry" /></mxCell>
        <mxCell id="r20-scenario" value="&lt;b&gt;End the portal session safely&lt;/b&gt;&lt;br&gt;1. Select Logout and cancel once. 2. Select Logout again and confirm. 3. Use browser Back and directly open a protected URL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="2436" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r20-expected" value="Cancel keeps the active session. Confirmed logout records the action when available, clears admin session and portal scope, redirects to Login, and prevents Back/direct URL from restoring protected content." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="2436" width="750" height="104" as="geometry" /></mxCell>
