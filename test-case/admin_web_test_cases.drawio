        <mxCell id="r17-scenario" value="&lt;b&gt;Filter, inspect, and export audit records&lt;/b&gt;&lt;br&gt;1. Perform known login/account/inventory actions. 2. Filter audit by date, actor, action, and module. 3. Open details. 4. Export summary and detailed PDFs." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="2124" width="790" height="104" as="geometry" /></mxCell>
        <mxCell id="r17-expected" value="Each action appears once with correct actor, timestamp, action label, table, and safe old/new details; filters return the expected subset; PDFs match the visible scoped data and do not expose hidden secrets." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2CDD7;fontColor=#382A31;fontSize=13;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1200" y="2124" width="750" height="104" as="geometry" /></mxCell>
