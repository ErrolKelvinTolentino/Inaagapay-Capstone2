# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── AI providers ────────────────────────────────────────────────────────
# Groq is the primary provider for reasoning, vision OCR, speech-to-text
# and text-to-speech.
GROQ_API_KEY=

# Optional. Fallback for text/reasoning calls when Groq is rate-limited or
# unreachable. OpenAI-compatible, so it reuses the same request path.
# Free key from https://build.nvidia.com
NVIDIA_API_KEY=

# Optional. Fallback for vision/OCR calls when the Groq vision models fail.
GEMINI_API_KEY=

# ── Notifications ───────────────────────────────────────────────────────
FCM_PRIVATE_KEY=
BREVO_API_KEY=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
